# Generic ignore patterns for the repository
# Version control
.git

# Logs and temporary files
*.log
*.tmp
*.swp

# OS generated files
.DS_Store
Thumbs.db

# IDE / editor folders
.vscode/
.idea/

# Python artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
*.egg-info/

# Node.js artifacts
node_modules/
package-lock.json
npm-debug.log

# Build artifacts
build/
bin/
obj/
out/
Dist/
/dist/

# Environment / secrets
.env*

# KiCad backups and caches
*-backups/
*.kicad_pcb-bak
*.kicad_sch-bak
*.kicad_prl
fp-info-cache
_autosave-*
\#auto_saved_files\#

# Cache files
.cache/

# Local source checkout and development scratch (preserved on disk)
/mini4wd-motor-driver/
/tmp/
/Microsoft/
/KiCad/
/.aws/
/.codex/
/drc_*.rpt
/mini4wd-motor-driver-drc.rpt
/mini4wd-motor-driver-erc.rpt
/releases/
# Editor/local history repositories
.history/
