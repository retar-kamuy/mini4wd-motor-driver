Q1 Q2 UCC27524 switching validation: stable-Rgp33-5.212886364-startup-0
.include UCC27524.lib
.include SiSS64DN.lib
.include DMP2008UFG-stable.lib
Vbat batt 0 PWL(0 0 20n 3.4)
Vdd dd 0 PWL(0 0 10u 0 30u 5.212886364)
Vlogic logic 0 PWL(0 0 35u 0 55u 3.3)
Vena ena 0 PWL(0 0 70u 0 70.02u 3.3)
Va a 0 3.3
Vb b 0 3.3
Xdrv a b oa ob dd ena logic 0 UCC27524
Rgn oa lgn 4.7
Rgp ob lgp 33
Lgn lgn gn 1e-07
Lgp lgp gp 1e-07
Lsn sn snx 5n
Rsn snx 0 .001
Lsp sp spx 5n
Rsp spx batt .001
Vqn m dn 0
Vqp m dp 0
Xn dn gn sn SiSS64DN
CextraN gn sn 1e-18
Xp dp gp sp DMP2008UFG
Rmotor batt wind .5
Lmotor wind m 10u
Dfly m batt Dfree
.model Dfree D(Is=1e-8 N=1 Rs=.01 BV=40 Cjo=500p Tt=3n)
BvgN vgn 0 V=V(gn,sn)
BvgP vgp 0 V=V(gp,sp)
BvdN vdn 0 V=V(dn,sn)
BvdP vdp 0 V=V(dp,sp)
.temp 27
.options method=gear reltol=.005 abstol=1e-8 chgtol=1e-14 trtol=7
.tran 1n 110u 0 1n
.measure tran vgn_max MAX V(vgn)
.measure tran vgn_min MIN V(vgn)
.measure tran vgp_max MAX V(vgp)
.measure tran vgp_min MIN V(vgp)
.measure tran vdn_max MAX V(vdn)
.measure tran vdn_min MIN V(vdn)
.measure tran vdp_max MAX V(vdp)
.measure tran vdp_min MIN V(vdp)
.control
run
set wr_singlescale
set wr_vecnames
wrdata stable-Rgp33-5.212886364-startup-0.dat v(vgn) v(vgp) v(vdn) v(vdp) i(vqn) i(vqp)
quit
.endc
.end
